# Optional gateway auth (Bearer / x-api-key). Empty = open.
ACCESS_TOKEN=

# Upstream OpenCode Zen base (no trailing slash)
UPSTREAM_BASE_URL=https://opencode.ai/zen/v1

# Optional upstream key if OpenCode requires one for your account
OPENCODE_API_KEY=

# Data directory (SQLite + JSON). Docker uses /data
DATA_DIR=./data

# Bind
HOST=0.0.0.0
PORT=8080

# Default: include local/direct egress in proxy pool
USE_DIRECT=true
